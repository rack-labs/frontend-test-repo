---
// One <head> for every page: meta, Open Graph, favicons, fonts, styles.
// Page-specific bits come in as props; nothing here is per-page markup.
interface Props {
  lang: 'en' | 'ko';
  title: string;
  description: string;
  ogType: 'website' | 'article';
  ogTitle: string;
  ogDescription: string;
  path: string;
  styles?: string[];
}

const { lang, title, description, ogType, ogTitle, ogDescription, path, styles = ['/style.css'] } = Astro.props;
const families = ['Archivo:wdth,wght@62..125,300..800', 'IBM+Plex+Mono:wght@400;500'];
if (lang === 'ko') families.push('Noto+Sans+KR:wght@400;500;700');
const fonts = `https://fonts.googleapis.com/css2?${families.map((f) => `family=${f}`).join('&')}&display=swap`;
const url = new URL(path, Astro.site).href;
const ogImage = new URL('/assets/og.png', Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fonts} />
  {styles.map((href) => <link rel="stylesheet" href={href} />)}
</head>
<body>
  <slot />
</body>
</html>
