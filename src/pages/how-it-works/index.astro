---
import Base from '../../layouts/Base.astro';
import SiteBar from '../../components/SiteBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
// How the rig measures, Korean edition (the default; English at /en/how-it-works/): four chapters
// over five animated pages (public/how-it-works/*.html), each page made for the review to show one
// part of the method. They are self-contained (three.js from /vendor/three/) with their captions in
// Korean. Embedded with ?embed=1 they show only the drawing, one thin progress bar and the caption,
// play on their own, loop, and pause while off screen or behind a tab. ?bg= is the section colour.
// A chapter is one grid: the animation on the left, the copy and what to look for beside it. The
// lens chapter has two pages behind tabs; the stacks are run by src/lib/viewer-tabs.js, and a page
// loads only when its stack comes near the screen.
const steps = [
  {
    id: 'shutter', n: 1, title: '글로벌 셔터를 쓰는 이유', sub: '같은 회전 날개를 두 방식으로 찍으면', ratio: 'tall',
    pages: [{ id: 'shutter', page: 'shutter.html', title: '글로벌 셔터를 쓰는 이유' }],
    text: [
      '롤링 셔터는 센서를 맨 윗줄부터 한 줄씩 노출합니다. 노출 선이 화면을 내려가는 동안 날개는 계속 돌기 때문에 줄마다 다른 순간의 날개가 찍히고, 곧은 날개가 휘어서 나옵니다. 빠르게 움직이는 바나 스쿼트 바닥에서의 무릎도 똑같이 휩니다.',
      '글로벌 셔터는 모든 줄을 같은 순간에 노출하고, 읽어 내기만 한 줄씩 합니다. 프레임 하나가 한 순간입니다. 리그의 카메라 세 대는 전기 펄스 하나로 찍는 글로벌 셔터 센서라, 사진 세 장을 점 단위로 맞출 수 있습니다. 0.12 ms 안의 같은 순간이기 때문입니다.',
    ],
    look: ['센서를 가로지르는 선이 이미 노출된 줄을 가릅니다. 선 위의 그림은 굳었고, 선 아래의 물체는 아직 움직입니다.', '센서 아래의 줄 타이밍 그래프가 두 방식의 차이 전부입니다.', '센서 격자가 먼저, 프로펠러가 그 아래에 있습니다.'],
  },
  {
    id: 'lens', n: 2, title: '렌즈 보정', sub: '카메라가 자기 초점 거리, 중심, 왜곡을 아는 방법', ratio: 'wide',
    pages: [
      { id: 'lens', tab: '원리', page: 'lens-principle.html', title: '렌즈 보정의 원리' },
      { id: 'lens-steps', tab: '리그의 실제 순서', page: 'lens-steps.html', title: '렌즈 보정, 리그의 실제 순서' },
    ],
    text: [
      '픽셀을 공간의 방향으로 바꾸려면 먼저 카메라를 수치로 적어야 합니다. 광학 중심이 어디인지, 초점 거리가 얼마인지, 렌즈가 가장자리에서 직선을 얼마나 휘는지입니다. 이 숫자가 내부 파라미터, 곧 행렬 K 와 왜곡 계수이고, 카메라 세 대가 저마다 다릅니다.',
      '카메라는 그 자리에 두고 보정 보드를 열 가지쯤 되는 자세로 보여 줍니다. 사진마다 찾은 코너가 보드 위의 점과 픽셀을 짝지어 줍니다. 그 짝에서 K 의 첫 추정값을 내고, 보드의 점을 모형으로 투영한 자리가 검출한 픽셀에 얹힐 때까지 다듬습니다. 남는 차이가 렌즈가 더한 왜곡이고, 이것을 모형으로 잡아 걷어 냅니다. 결과는 카메라마다 K 파일 하나이고, 그 뒤의 모든 단계가 이 파일을 읽습니다.',
      '두 번째 탭 ‘리그의 실제 순서’는 같은 보정을 리그 OS 가 수행하는 순서 그대로 보입니다. 촬영 조건을 고정하고, 보드를 여러 자세로 찍고, 코너를 검출하고, K 를 풀고, 맞춤에서 뺀 사진으로 결과를 검사한 뒤에 K 파일을 씁니다. 파일을 받아들일지는 hold-out 단계가 정합니다.',
    ],
    look: ['여섯 단계가 리그가 도는 순서대로 나오고, 자막이 단계마다 이름을 붙입니다.', '오른쪽 위의 작은 창이 그 순간 카메라가 보는 화면입니다. 실제 순서에서는 자세별 보드, 검출한 코너, 재투영한 점과 잔차가 차례로 나옵니다.', '끌어서 장면을 돌려도 재생은 이어집니다.'],
  },
  {
    id: 'position', n: 3, title: '위치 보정', sub: '카메라 세 대가 랙 좌표계의 어디에 있는지', ratio: 'wide',
    pages: [{ id: 'position', page: 'ext-principle.html', title: '위치 보정' }],
    text: [
      '렌즈 보정은 카메라를 한 대씩 적습니다. 위치 보정은 세 대를 하나의 기준, 곧 랙 위에 놓습니다. 랙의 정해진 자리에 보드를 두고 카메라마다 관측합니다. 보드의 코너에서 랙을 기준으로 한 카메라의 회전과 위치를 계산하고, 랙의 실제 치수와 대조해 검사하고, 여러 프레임에 걸쳐 되풀이해 합친 뒤 파일로 씁니다.',
      '그 뒤로는 카메라 두세 대에 보이는 어떤 점이든 랙 원점에서 몇 cm 인지로 자리를 줄 수 있습니다. 카메라가 랙에 볼트로 고정돼 있어 이 보정은 다음 세션에도 그대로 유효합니다.',
    ],
    look: ['네 단계: 관측, 계산, 검사, 파일.', '여기 그린 랙은 실제 치수의 PVC 시제품입니다.', '원래 있던 것은 움직이지 않고, 계산한 값만 나타납니다.'],
  },
  {
    id: 'measure', n: 4, title: '측정', sub: '같은 순간의 사진 세 장에서 관절, 지표, 하중까지', ratio: 'wide',
    pages: [{ id: 'measure', page: 'measure-principle.html', title: '측정' }],
    text: [
      '트리거가 걸린 프레임마다 관절 검출기가 사진 세 장에서 2D 관절을 찾습니다. K 로 그 픽셀의 렌즈 왜곡을 걷어 내면 픽셀마다 카메라에서 나가는 광선이 됩니다. 관절 하나를 향한 세 카메라의 광선은 공간의 한 점에서 만나고, 그 교점이 관절의 3D 위치입니다. 이것을 관절 33개에 대해, 세트 내내 프레임마다 구합니다.',
      '위치 보정을 거치면 그 점들이 랙 좌표로 표현되어 깊이, 기울기, 좌우 비대칭, 바의 궤적을 바로 읽습니다. 시간에 따른 관절 위치와 바에 실린 무게에서 반복마다 관절별 하중을 계산하고, 반복 횟수도 움직임에서 셉니다.',
    ],
    look: ['네 단계: 2D 관절, 광선, 교점, 그리고 지표와 하중과 반복이 붙은 랙 좌표.', '카메라 1은 90° 돌려 달았으므로 작은 창이 세로로 섭니다.', '관절 33개 뒤의 연속 장면은 같은 프레임 계산을 움직임 내내 되풀이한 것입니다.'],
  },
];
---
<Base
  lang="ko"
  title="RackTracker 산출 원리"
  description="RackTracker 가 세트를 재는 원리. 카메라가 글로벌 셔터를 쓰는 이유, 렌즈 보정, 카메라 세 대를 랙 좌표계에 놓는 위치 보정, 그리고 같은 순간의 사진 세 장이 관절 33개와 지표, 관절별 하중이 되는 과정. 애니메이션 다섯 개."
  ogType="article"
  ogTitle="RackTracker 산출 원리"
  ogDescription="글로벌 셔터, 렌즈 보정, 위치 보정, 측정. 애니메이션 다섯 개."
  path="/how-it-works/"
  alt="/en/how-it-works/"
>
  <SiteBar lang="ko" current="/how-it-works/" alt="/en/how-it-works/" />

  <main id="top">
    <section class="wing first" id="overview" aria-labelledby="hiw-title">
      <div class="head">
        <h2 id="hiw-title">산출 원리</h2>
        <p>리그가 일하는 순서대로, 네 장에 애니메이션 다섯 개</p>
      </div>
      <div class="text">
        <p class="lede">리그는 같은 순간의 사진 세 장을 관절 33개의 3D 위치로 바꾸고, 거기서 지표와 관절별 하중을 냅니다. 아래 애니메이션이 그 과정을 한 부분씩 보여 줍니다. 심사에서 보인 것과 같고, 저절로 재생되며 끝나면 처음부터 다시 돕니다.</p>
        <p>3D 장면은 끌어서 돌릴 수 있습니다.</p>
      </div>
    </section>

    <nav class="steps-nav" aria-label="장">
      <ol>{steps.map((s) => <li><a href={`#${s.id}`}><span class="num">{s.n}</span>{s.title}</a></li>)}</ol>
    </nav>

    {steps.map((s) => (
      <section class="wing hiw" id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="head">
          <h2 id={`${s.id}-title`}><span class="num">{s.n}</span>{s.title}</h2>
          <p>{s.sub}</p>
        </div>
        {s.pages.slice(1).map((p) => <span id={p.id}></span>)}
        <div class="hiw-grid">
          <div class="hiw-stage">
            {s.pages.length > 1 && (
              <div class="hw-tabs" role="tablist" aria-label={s.title} data-page={s.pages[0].id}>
                {s.pages.map((p, i) => <button type="button" role="tab" id={`tab-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-page={p.id}>{p.tab}</button>)}
              </div>
            )}
            <div class:list={['hw-frames', s.ratio]}>
              {s.pages.map((p, i) => (
                <div class:list={['hw-frame', 'hiw-frame', { on: i === 0 }]} data-page={p.id} id={`frame-${p.id}`} aria-hidden={i === 0 ? 'false' : 'true'} inert={i !== 0}>
                  <p class="placeholder">{p.title}</p>
                  <iframe title={p.title} data-src={`/how-it-works/${p.page}?embed=1&bg=eceef1`} loading="lazy"></iframe>
                </div>
              ))}
            </div>
          </div>
          <div class="hiw-text">
            {s.text.map((t) => <p class="lede">{t}</p>)}
            <dl class="facts look">
              <div><dt>볼 곳</dt><dd><ul>{s.look.map((l) => <li>{l}</li>)}</ul></dd></div>
            </dl>
          </div>
        </div>
      </section>
    ))}
  </main>

  <SiteFooter lang="ko" />

  <script>
    import { mountViewerTabs } from '../../lib/viewer-tabs.js';
    // one stack per chapter; a page loads once its stack comes near the screen
    document.querySelectorAll<HTMLElement>('.hiw-stage').forEach((s) => mountViewerTabs(s, { margin: '400px 0px' }));
    // the strip marks the chapter on screen
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.steps-nav a')];
    const sections = [...document.querySelectorAll<HTMLElement>('section.hiw')];
    const mark = () => {
      const y = scrollY + innerHeight * 0.4;
      const cur = sections.filter((s) => s.offsetTop <= y).pop();
      links.forEach((a) => { if (cur && a.getAttribute('href') === '#' + cur.id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
    };
    addEventListener('scroll', mark, { passive: true }); mark();
  </script>
</Base>
