---
import Base from '../../layouts/Base.astro';
import SiteBar from '../../components/SiteBar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getHeadings } from '../../report/project-report.md';

// The home page is the review in one scroll: the hero, the rig (three live 3D viewers from
// public/hardware/), the demo video, the slide deck (built into public/slides/ by
// scripts/slides/build.mjs) and the Project Report (/report/, from scripts/report/import.mjs).
// The deeper pages, How it works, Research and Open source, hang off the top bar.
const chapters = getHeadings().filter((h) => h.depth === 2);

// The demo video: the narrated demo of one full set (5 min 19 s, 88 MB). Files over the 25 MiB
// static-asset limit live in the R2 bucket racktracker-files behind files.racktracker.dev (dated
// keys, immutable cache); the poster is the RackTracker title card. A YouTube id,
// when set, adds a link beside it.
const FILES = 'https://files.racktracker.dev';
const DEMO = {
  src: `${FILES}/demo/RackTracker_demo_2026-11-01.mp4`, type: 'video/mp4', poster: '/assets/demo/demo-thumbnail.webp', width: 1920, height: 1080,
  youtube: '',
  note: 'Five minutes 19 seconds, narrated in Korean with Korean subtitles.',
};
// The PowerPoint export of the deck (98 MB), from the same bucket; its Content-Disposition names the download RackTracker.pptx.
const PPTX = `${FILES}/graduation-review/RackTracker_2026-11-01.pptx`;
const PDF = { href: '/report/RackTracker_Project_Report.pdf', size: '8 MB', pages: 40 };

const parts = [
  {
    id: 'rig', tab: 'Rig layout', title: 'Rig layout, 3D', kicker: 'The rig as built',
    lede: 'A power-rack mock-up with the three cameras on its rear storage posts, the tablet on the right post and the compute enclosure on the left one. The camera poses are the real ones from the position calibration of 28 August 2026, so what the viewer shows is where the cameras actually look.',
    spec: [
      ['Rack', '118 × 106 × 241 cm', 'PVC mock-up of a power rack, built to measure'],
      ['Cameras', '3, on the rear posts', 'turned 90° so a person 2 m away fits one frame top to toe'],
      ['Trigger', 'one pulse to all three', 'exposure spread across the cameras 0.12 ms (median)'],
      ['Capture', '1920 × 1200 at 30 fps', 'MJPG, three cameras on one powered USB 3 hub'],
      ['Compute', 'Jetson Orin NX 16 GB', 'in one enclosure with the trigger board and the hub'],
      ['Display', 'tablet, USB tethered', 'a closed link: no video leaves the rack'],
      ['Sync', '100% of pulses', '900 of 900 per camera once USB 3 power saving was off'],
    ],
    links: [['/report/#4-리그-하드웨어', 'Report, chapter 4'], ['/how-it-works/', 'How it works']],
  },
  {
    id: 'carrier', tab: 'Compute unit', title: 'Compute carrier, 3D', kicker: 'Jetson Orin NX on an Advantech MIC-711D-OX',
    lede: 'The computer beside the rack. An NVIDIA Jetson Orin NX module sits on an Advantech carrier in a fanless aluminium case; the board is drawn from photographs of the unit in the rig, every part taller than a millimetre in place. It runs the joint detector, the triangulation and everything after it.',
    spec: [
      ['Module', 'Jetson Orin NX 16 GB', 'Super mode: 157 TOPS, 8-core Arm Cortex-A78AE at 2.0 GHz'],
      ['GPU', '1,024 CUDA cores, 1,173 MHz', 'Ampere, with two DLA engines'],
      ['Memory', '16 GB LPDDR5', 'NVMe SSD on the M.2 2280 slot'],
      ['Power', '10 to 40 W', 'passive cooling, no fan'],
      ['Carrier', 'MIC-711D-OX', '125 × 124.14 × 50.62 mm'],
      ['I/O used', 'USB 3.2 Gen1 × 2, USB 2.0, GbE', 'the cameras on one hub, the tablet on the other port'],
      ['Software', 'JetPack 6.2.1, TensorRT', 'the rig OS and the kiosk server, Linux'],
    ],
    links: [['https://www.nvidia.com/en-us/autonomous-machines/embedded-systems/jetson-orin/', 'NVIDIA Jetson Orin'], ['https://www.advantech.com/en/search?q=MIC-711D-OX', 'Advantech MIC-711D-OX'], ['/report/#4-2-연산-장비와-usb', 'Report, 4-2']],
  },
  {
    id: 'camera', tab: 'Camera module', title: 'Camera module, 3D', kicker: 'DECXIN-3081V1 with the onsemi AR0234 sensor',
    lede: 'One of the three cameras, without its housing: a 38 mm board with a global-shutter sensor and a wide, low-distortion M12 lens. The three fire together on one hardware trigger line, so a fast bar and limbs are caught straight and at the same instant in all three views.',
    spec: [
      ['Sensor', 'onsemi AR0234CS', '1/2.6-inch, 2.3 MP, global shutter'],
      ['Resolution', '1920 × 1200', 'used at 30 fps per camera'],
      ['Lens', 'M12, 4.1 mm, F2.0', 'about 120°, low distortion; calibrated per camera'],
      ['Board', '38 × 38 mm', 'four M2 holes on a 34 mm pitch'],
      ['Interface', 'USB 3.0, USB-C', 'UVC; MJPG when three stream on one hub'],
      ['Trigger', 'TRG / STRB / GND header', 'one frame per rising edge of the external trigger'],
      ['Exposure', 'fixed per session', 'auto exposure, white balance and focus are off'],
    ],
    links: [['https://www.onsemi.com/products/sensors/image-sensors/ar0234cs', 'onsemi AR0234CS'], ['/report/#4-1-카메라와-동기-트리거', 'Report, 4-1'], ['/how-it-works/#shutter', 'Shutter, how it works']],
  },
];
---
<Base
  lang="en"
  title="RackTracker by Rack Labs"
  description="RackTracker turns the power rack into a motion-capture studio: three synchronized cameras and an edge computer mounted on the rack show, for every rep, which joints took the load and which muscles carried it. The rig in 3D, the demo video, the review slides and the project report."
  ogType="website"
  ogTitle="RackTracker by Rack Labs"
  ogDescription="Turn the power rack into a motion-capture studio. For every rep, see which joints took the load and which muscles carried it."
  path="/en/"
  alt="/"
>
  <SiteBar lang="en" home alt="/" />

  <main id="top">
    <section class="hero" id="hero" aria-labelledby="hero-title" data-show="still">
      <div class="live" id="hero-live" aria-hidden="true"></div>
      <div class="poster" aria-hidden="true">
        <div class="stage" id="hero-stage">
          <img class="still" src="/assets/hero-scene.webp" alt="" width="1440" height="1200">
          <video id="hero-video" muted playsinline disablepictureinpicture preload="none" poster="/assets/hero-mhr.webp" width="1440" height="1200"></video>
        </div>
      </div>
      <script>
        // The hero runs in sequences. First, rendered live (three.js) as one
        // scene: the rig as built (rack, three cameras, tablet, compute
        // enclosure, cable runs), then how one frame becomes rack coordinates,
        // rays from the three cameras through the detected joint, the point
        // where they meet, all 33 joints, the same frame after frame through
        // a squat, then the move from the floor frame to the rack frame. Visitors can drag it around. On wide screens its canvas fills the whole section, framed
        // so the view through the stage box is what the box alone would show;
        // on narrow ones it sits in the box. Second, the recorded loop of the
        // post-processed MHR body
        // of a real set on the prototype rig (5 October 2026), 2160 px wide
        // for wide screens and 1080 for narrow ones. Then the first again.
        // Without WebGL the recorded loop plays alone; reduced motion shows
        // the finished live frame without playing it.
        // The recorded loop was rendered on the old dark page colour, so on the
        // light page it is off until it is rendered again on --bg: the live
        // sequence repeats alone, and without WebGL the still stands in.
        const mhr = false;
        const hero = document.getElementById('hero') as HTMLElement;
        const stage = document.getElementById('hero-stage') as HTMLElement;
        const liveBox = document.getElementById('hero-live') as HTMLElement;
        const v = document.getElementById('hero-video') as HTMLVideoElement;
        const narrow = matchMedia('(max-width: 900px)');
        const place = () => { const home = narrow.matches ? stage : hero; if (liveBox.parentElement !== home) home.append(liveBox); };   // in the box: above the still and the video
        place(); narrow.addEventListener('change', place);
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const check = /hero=check/.test(location.hash);
        let visible = true;
        let live: { play(): void; setActive(on: boolean): void; seek(t: number): string } | null = null;
        let sourced = false;
        const source = () => {
          if (sourced) return;
          sourced = true;
          const rung = narrow.matches ? 'hero-mhr-1080' : 'hero-mhr-2160';
          for (const [ext, type] of [['webm', 'video/webm'], ['mp4', 'video/mp4']]) {
            const s = document.createElement('source');
            s.src = `/assets/${rung}.${ext}`; s.type = type; v.appendChild(s);
          }
          v.preload = 'auto'; v.load();
        };
        const playVideo = (loop: boolean) => {
          source();
          v.loop = loop; v.currentTime = 0; hero.dataset.show = 'video';
          if (visible) v.play().catch(() => {});
        };
        let webgl = false;
        try { const c = document.createElement('canvas'); webgl = !!(c.getContext('webgl2') || c.getContext('webgl')); } catch (_) { /* no WebGL */ }
        if (!webgl) { if (!still && mhr) playVideo(true); }
        else {
          import('../../lib/hero-scene.js')
            .then(m => {
              live = m.mountHeroScene(liveBox, {
                still: still || check,
                // framed for a 6:5 box with the target right of centre, clear of the
                // copy; on narrow screens that box is the square stage cropped the way
                // the still is (object-position 100%), so the two line up
                frame: () => {
                  const L = liveBox.getBoundingClientRect(), B = stage.getBoundingClientRect();
                  const w = narrow.matches ? B.height * 1.2 : B.width;
                  return { x: B.right - L.left - w, y: B.top - L.top, w, h: B.height, fx: 0.63, fy: 0.44 };
                },
                onEnd: () => { if (!mhr) { live!.play(); return; } live!.setActive(false); playVideo(false); },
                onFail: () => { live = null; if (mhr) playVideo(true); else hero.dataset.show = 'still'; },
              });
              hero.dataset.show = 'live';
              live.setActive(visible);
              if (check) (window as any).__heroScene = live;
              else if (!still && mhr) setTimeout(source, 6000);        // fetch the loop while the first sequence plays
            })
            .catch(e => { console.warn('[hero] live path failed:', e); if (!still && mhr) playVideo(true); });
          v.addEventListener('ended', () => {
            if (!live) return;
            hero.dataset.show = 'live'; live.setActive(visible); live.play();
          });
        }
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(es => es.forEach(e => {
            visible = e.isIntersecting;
            if (hero.dataset.show === 'live') live?.setActive(visible);
            else if (hero.dataset.show === 'video') { if (visible) v.play().catch(() => {}); else v.pause(); }
          }), { threshold: 0.05 }).observe(stage);
        }
      </script>
      <div class="veil" aria-hidden="true"></div>
      <div class="copy">
        <p class="kicker">RackTracker by Rack Labs</p>
        <h1 id="hero-title">Turn the power rack into a <span class="nb">motion-capture</span> studio.</h1>
        <p class="lede">Three synchronized cameras and an edge computer, mounted on the rack, show the trainer where the weight went on every rep: which joints took the load, and which muscles carried it.</p>
        <div class="cta">
          <a class="btn" href="#hardware">See the rig</a>
          <a class="btn ghost" href="#demo">Watch the demo</a>
        </div>
      </div>
      <div class="cue" aria-hidden="true"><i></i>scroll</div>
    </section>

    <section class="wing" id="hardware" aria-labelledby="hw-title">
      <div class="head">
        <h2 id="hw-title">The rig</h2>
        <p>Three cameras, a trigger board, an edge computer and a tablet, fixed to one power rack</p>
      </div>
      <div class="cols">
        <div class="text">
          <p class="lede">RackTracker is a physical product: three global-shutter cameras and an NVIDIA Jetson fixed to the rack, with the software that runs on it, installed as one unit per rack. The cameras fire on one electrical trigger, the joints found in each view are intersected from three directions, and when one view is occluded the other two carry it.</p>
          <p>Because the setup never changes, every session compares with the last one on the same footing. Processing finishes on the computer beside the rack, on a closed network, so member video never leaves the gym.</p>
        </div>
        <dl class="facts">
          <div><dt>Shutter spread across three cameras</dt><dd>0.12 ms<small>measured with a logic analyzer</small></dd></div>
          <div><dt>Joints recovered with three cameras</dt><dd>70%<small>CMU Panoptic. Standard triangulation: 40%</small></dd></div>
          <div><dt>Joint position error</dt><dd>~3 cm<small>the same as with two cameras</small></dd></div>
        </dl>
      </div>

      <div class="hw">
        <div class="hw-stage">
          <div class="hw-frame" id="hw-frame">
            <img class="hw-still" id="hw-still" src="/hardware/still/rig.webp" width="1200" height="900" alt="Rig layout drawing: the rack, three cameras, the tablet and the compute enclosure">
            <iframe id="hw-view" title="Rig layout, 3D" loading="lazy"></iframe>
          </div>
        </div>
        <div class="hw-side">
          <div class="hw-tabs" role="tablist" aria-label="Part">
            {parts.map((p, i) => <button type="button" role="tab" id={`tab-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`hw-${p.id}`} data-page={p.id} data-title={p.title}>{p.tab}</button>)}
          </div>
          {parts.map((p, i) => (
            <div class="hw-panel" id={`hw-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
              <p class="kicker">{p.kicker}</p>
              <p>{p.lede}</p>
              <dl class="spec">
                {p.spec.map(([k, v, s]) => <div><dt>{k}</dt><dd>{v}<small>{s}</small></dd></div>)}
              </dl>
              <p class="links">{p.links.map(([href, label]) => <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>)}</p>
            </div>
          ))}
        </div>
      </div>
      <script>
        // One viewer frame, three pages behind it (public/hardware/*.html). The page loads only once the
        // section is near the screen; until its first frame is drawn (it posts {hw:'ready'}) the still
        // of that part stands in, and it stays if WebGL is missing. The pages draw on the page colour
        // (?bg=), with no chrome of their own, so the drawing sits on the section like the hero does.
        const frame = document.getElementById('hw-frame') as HTMLElement;
        const view = document.getElementById('hw-view') as HTMLIFrameElement;
        const stillImg = document.getElementById('hw-still') as HTMLImageElement;
        const tabs = [...document.querySelectorAll<HTMLButtonElement>('.hw-tabs [role=tab]')];
        let near = false;
        const pageOf = (id: string) => `/hardware/${id}.html`;
        const load = (id: string) => { frame.classList.remove('ready'); view.src = pageOf(id) + '?bg=eceef1'; };
        const show = (btn: HTMLButtonElement) => {
          const id = btn.dataset.page!;
          tabs.forEach(b => { const on = b === btn; b.setAttribute('aria-selected', String(on)); (document.getElementById(b.getAttribute('aria-controls')!) as HTMLElement).hidden = !on; });
          stillImg.src = `/hardware/still/${id}.webp`; view.title = btn.dataset.title!;
          if (near) load(id); else frame.classList.remove('ready');
        };
        tabs.forEach(b => b.addEventListener('click', () => show(b)));
        addEventListener('message', e => { if (e.data && e.data.hw === 'ready') frame.classList.add('ready'); });
        const start = () => { near = true; const on = tabs.find(b => b.getAttribute('aria-selected') === 'true')!; load(on.dataset.page!); };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '300px 0px' });
          io.observe(frame);
        } else start();
      </script>
    </section>

    <section class="wing" id="demo" aria-labelledby="demo-title">
      <div class="head">
        <h2 id="demo-title">Demo video</h2>
      </div>
      <figure class="sheet demo">
        <video controls playsinline preload="metadata" poster={DEMO.poster} width={DEMO.width} height={DEMO.height}>
          <source src={DEMO.src} type={DEMO.type} />
        </video>
        <figcaption>{DEMO.note}{DEMO.youtube && <> <a href={`https://www.youtube.com/watch?v=${DEMO.youtube}`} rel="noopener">Watch on YouTube</a>.</>}</figcaption>
      </figure>
    </section>

    <section class="wing" id="slides" aria-labelledby="slides-title">
      <div class="head">
        <h2 id="slides-title">Review deck</h2>
        <p>Eleven slides, three minutes, as presented at the graduation review (Korean)</p>
      </div>
      <div class="sheet deck">
        <div class="deck-frame" id="deck-frame">
          <iframe src="/slides/?embed#/graduation-review/1" title="RackTracker review deck" loading="lazy" allow="fullscreen"></iframe>
        </div>
        <div class="deck-bar">
          <span class="hint">Click the deck, then step through it with the arrow keys.</span>
          <span class="deck-actions">
            <button type="button" class="mini" id="deck-full">Full screen</button>
            <a class="mini" href="/slides/#/graduation-review/1" target="_blank" rel="noopener">Open in a new tab</a>
            {PPTX
              ? <a class="mini strong" href={PPTX} download>Download PowerPoint (98 MB)</a>
              : <span class="mini off" title="The PowerPoint export is being put up">PowerPoint, soon</span>}
          </span>
        </div>
      </div>
      <script>
        const deck = document.getElementById('deck-frame') as HTMLElement;
        document.getElementById('deck-full')!.addEventListener('click', () => {
          const tab = () => window.open('/slides/#/graduation-review/1', '_blank');
          if (deck.requestFullscreen) deck.requestFullscreen().catch(tab); else tab();
        });
      </script>
    </section>

    <section class="wing" id="report" aria-labelledby="report-title">
      <div class="head">
        <h2 id="report-title">Project Report</h2>
        <p>The full write-up for the review, in Korean: nine chapters, 29 figures, 7 tables</p>
      </div>
      <div class="cols">
        <div class="text">
          <p class="lede">Why the rig exists, what it is made of, how the rig OS, the camera calibration and the 3D measurement work, how the load on each joint is computed, and how all of it was validated.</p>
          <ol class="chapters">
            {chapters.map((c) => <li><a href={`/report/#${c.slug}`}>{c.text}</a></li>)}
          </ol>
          <div class="cta">
            <a class="btn" href="/report/">Read it online</a>
            <a class="btn ghost" href={PDF.href} download>Download the PDF ({PDF.size}, {PDF.pages} pages)</a>
          </div>
        </div>
        <div class="figs">
          <figure class="sheet">
            <img src="/report/figures/fig08_flow.jpg" alt="The four procedures of the rig as kiosk screens: diagnosis, lens calibration, position calibration and measurement" loading="lazy" decoding="async" />
            <figcaption>From the report: the four procedures, diagnosis, lens calibration, position calibration and measurement.</figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang="en" home />

  <script is:inline>
    // Top bar turns solid as soon as the page scrolls
    (function () {
      var bar = document.getElementById('bar');
      function update() { bar.classList.toggle('solid', window.scrollY > 24); }
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();
    // Copy the address: a path for machines without a mail client
    (function () {
      var btn = document.querySelector('.foot .copybtn');
      if (!btn) return;
      var label = btn.textContent;
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy');
        var done = function () {
          btn.textContent = btn.getAttribute('data-done');
          btn.classList.add('done');
          setTimeout(function () { btn.textContent = label; btn.classList.remove('done'); }, 2000);
        };
        var fallback = function () {
          // Clipboard blocked: select the address so Ctrl+C works
          var link = btn.parentNode.querySelector('a');
          var range = document.createRange(); range.selectNodeContents(link);
          var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
          btn.textContent = btn.getAttribute('data-selected');
          setTimeout(function () { btn.textContent = label; }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, fallback);
        } else {
          fallback();
        }
      });
    })();
  </script>
</Base>
