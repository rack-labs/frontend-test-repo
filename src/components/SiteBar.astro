---
// Top bar. On the home page the section links jump within the page and the bar
// turns solid on scroll (script in index.astro); on other pages it starts solid
// and the section links go back to the home page. The page links are the same
// everywhere; the one for the current page is marked. Korean is the default
// language and lives at /, English at /en/; the switch at the right end goes to
// the same page in the other language (`alt`, when the page has one).
interface Props {
  lang: 'ko' | 'en';
  home?: boolean;
  current?: string;
  alt?: string;
}

const { lang, home = false, current, alt } = Astro.props;
const root = lang === 'en' ? '/en/' : '/';
const at = home ? '' : root;
const links = lang === 'en'
  ? [
      { href: `${at}#hardware`, label: 'The rig' },
      { href: `${at}#demo`, label: 'Demo' },
      { href: `${at}#slides`, label: 'Slides' },
      { href: '/en/report/', label: 'Report' },
      { href: '/en/how-it-works/', label: 'How it works' },
      { href: '/en/research/', label: 'Research' },
      { href: '/en/open-source/', label: 'Open source' },
      { href: `${at}#contact`, label: 'Contact' },
    ]
  : [
      { href: `${at}#hardware`, label: '리그' },
      { href: `${at}#demo`, label: '시연' },
      { href: `${at}#slides`, label: '발표 자료' },
      { href: '/report/', label: '보고서' },
      { href: '/how-it-works/', label: '산출 원리' },
      { href: '/research/', label: '연구 동향' },
      { href: '/open-source/', label: '오픈 소스' },
      { href: `${at}#contact`, label: '연락처' },
    ];
const ko = lang === 'ko' ? undefined : alt;
const en = lang === 'en' ? undefined : alt;
---
<header class:list={['bar', { solid: !home }]} id="bar">
  <a class="brand" href={home ? '#top' : root}>
    <!-- favicon.svg mark without its dark tile, filled with the text colour -->
    <svg viewBox="0 0 144 144" aria-hidden="true"><rect width="89" height="89"/><path d="M110 0H144V127L110 93Z"/><path d="M0 110H97L131 144H0Z"/></svg>
    Rack Labs
  </a>
  <nav aria-label={lang === 'en' ? 'Sections' : '구역'}>
    {links.map((l) => <a href={l.href} aria-current={l.href === current ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  {alt && (
    <nav class="lang" aria-label={lang === 'en' ? 'Language' : '언어'}>
      {ko ? <a href={ko} hreflang="ko" lang="ko">한국어</a> : <span aria-current="true" lang="ko">한국어</span>}
      {en ? <a href={en} hreflang="en" lang="en">EN</a> : <span aria-current="true" lang="en">EN</span>}
    </nav>
  )}
</header>
<script is:inline>
  // On a phone the bar is two lines tall (a quarter of the screen), so it slides up as the page
  // scrolls down and comes back on the first scroll up (html.bar-away; style.css, 640px and
  // under). A jump to a section, from a link here or from the address, hides it before the
  // scroll starts and holds it for a second, so the section lands at the top and not under the bar.
  (function () {
    var html = document.documentElement, bar = document.getElementById('bar');
    var last = window.scrollY, hold = 0;
    function away(on) { html.classList.toggle('bar-away', on); }
    function jump() { away(true); hold = Date.now() + 1000; }
    window.addEventListener('scroll', function () {
      var y = window.scrollY;
      if (Date.now() < hold) { last = y; return; }
      if (y <= 24) away(false);
      else if (y > last + 4) away(true);
      else if (y < last - 4) away(false);
      else return;
      last = y;
    }, { passive: true });
    bar.addEventListener('click', function (e) {
      var a = e.target.closest('a');
      if (a && a.hash && a.hash !== '#top' && a.host === location.host && a.pathname === location.pathname) jump();
    });
    if (location.hash && location.hash !== '#top') jump();
    setTimeout(function () { last = window.scrollY; if (last <= 24) away(false); }, 1100);
  })();
</script>
