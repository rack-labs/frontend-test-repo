---
// Top bar. On the home page the links jump within the page and the bar turns
// solid on scroll (script in index.astro); on other pages it starts solid and
// the section links go back to the home page.
interface Props {
  home?: boolean;
  current?: string;
}

const { home = false, current } = Astro.props;
const at = home ? '' : '/';
const links = [
  { href: `${at}#racktracker`, label: 'RackTracker' },
  { href: `${at}#prototype`, label: 'Prototype' },
  { href: '/business-plan/', label: 'Business plan' },
  { href: `${at}#open-source`, label: 'Open source' },
  { href: `${at}#contact`, label: 'Contact' },
];
---
<header class:list={['bar', { solid: !home }]} id="bar">
  <a class="brand" href={home ? '#top' : '/'}>Rack Labs</a>
  <nav aria-label="Sections">
    {links.map((l) => <a href={l.href} aria-current={l.href === current ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</header>
